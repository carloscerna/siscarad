@section('scripts')
<script>
$(document).ready(function() {
    $('#formLiteralB').submit(function(e) {
        e.preventDefault();
        let id_alumno = $('#id_alumno').val();

        $.ajax({
            url: "/ficha-estudiante/" + id_alumno + "/guardar-literal-b",
            type: "PUT",
            data: $(this).serialize(),
            success: function(response) {
                if (response.status === 'success') {
                    alert(response.message);
                }
            },
            error: function(xhr) {
                alert('Error al guardar la información. Verifique los campos.');
            }
        });
    });
});
</script>
